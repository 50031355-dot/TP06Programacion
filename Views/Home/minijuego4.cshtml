@{
    ViewData["Title"] = "Minijuego 4 - Memoria";

    int pistasUsadas = 0;
    if (ViewBag.PistasUsadas != null)
    {
        pistasUsadas = (int)ViewBag.PistasUsadas;
    }

    string errorPista = "";
    if (ViewBag.ErrorPista != null)
    {
        errorPista = ViewBag.ErrorPista.ToString();
    }

    string pista = "";
    if (ViewBag.Pista != null)
    {
        pista = ViewBag.Pista.ToString();
    }

    int numeroPista = 0;
    if (ViewBag.PistaNumero != null)
    {
        numeroPista = (int)ViewBag.PistaNumero;
    }

    int codigoMinijuego = 3025;
    if (ViewBag.CodigoMinijuego != null)
    {
        codigoMinijuego = (int)ViewBag.CodigoMinijuego;
    }
}

<div class="container mt-5 spider-theme">
    <div class="text-center mb-4">
        <span class="spider-badge">🕷 Sala 4</span>
        <h1 class="mt-3 mb-2">Minijuego 4: Memoria del Telaraña</h1>
        <p class="text-white-50 mb-0">Encuentra las parejas antes de que la telaraña termine su patrón.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 spider-card">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <p class="mb-0 fs-5 flex-grow-1 text-center">Poné en juego tu memoria y descubre todas las parejas.</p>
                </div>
                <div id="mensaje" class="alert d-none mb-3" role="alert"></div>

                <div id="memoryBoard" class="memory-board mb-4" data-codigo="@codigoMinijuego">
                    <button class="memory-card" data-symbol="carnage" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/carnage.png" alt="Carta 1" /></span>
                    </button>
                    <button class="memory-card" data-symbol="carnage" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/carnage.png" alt="Carta 2" /></span>
                    </button>
                    <button class="memory-card" data-symbol="miles" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/miles.png" alt="Carta 3" /></span>
                    </button>
                    <button class="memory-card" data-symbol="miles" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/miles.png" alt="Carta 4" /></span>
                    </button>
                    <button class="memory-card" data-symbol="duende" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/duende.png" alt="Carta 5" /></span>
                    </button>
                    <button class="memory-card" data-symbol="duende" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/duende.png" alt="Carta 6" /></span>
                    </button>
                    <button class="memory-card" data-symbol="spiderman" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/spiderman.png" alt="Carta 7" /></span>
                    </button>
                    <button class="memory-card" data-symbol="spiderman" type="button">
                        <span class="card-front">?</span>
                        <span class="card-back"><img src="/img/spiderman.png" alt="Carta 8" /></span>
                    </button>
                </div>

                <div class="text-center">
                    <button type="button" id="reiniciarMemoria" class="btn btn-warning spider-btn">Reiniciar</button>
                </div>

                <div id="codigoDiv" class="alert alert-success d-none mt-4">
                    <h5>¡Felicidades!</h5>
                    <p>Encontraste todas las parejas.</p>
                    <form action="@Url.Action("VerificarMinijuego", "Home")" method="post">
                        <input type="hidden" name="codigo" id="codigoInput" value="">
                        <button type="submit" class="btn btn-primary mt-3 spider-btn">Completar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/minijuegos.js" asp-append-version="true"></script>
