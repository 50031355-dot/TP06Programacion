@{
    ViewData["Title"] = "Minijuego 2 - Adivina la Palabra";

    int pistasUsadas = 0;
    if (ViewBag.PistasUsadas != null)
    {
        pistasUsadas = (int)ViewBag.PistasUsadas;
    }

    string errorPista = "";
    if (ViewBag.ErrorPista != null)
    {
        errorPista = ViewBag.ErrorPista.ToString();
    }

    string pista = "";
    if (ViewBag.Pista != null)
    {
        pista = ViewBag.Pista.ToString();
    }

    int numeroPista = 0;
    if (ViewBag.PistaNumero != null)
    {
        numeroPista = (int)ViewBag.PistaNumero;
    }

    string palabraSecreta = "PETER";
    if (ViewBag.PalabraSecreta != null)
    {
        palabraSecreta = ViewBag.PalabraSecreta.ToString();
    }
}

<div class="container mt-5 goblin-theme">
    <div class="text-center mb-4">
        <span class="spider-badge">🕷 Sala 2</span>
        <h1 class="mt-3 mb-2">Minijuego 2: El acertijo del Duende Verde</h1>
        <p class="text-white-50 mb-0">Adivina la palabra secreta antes de que se agoten tus intentos y la guarida se cierre.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card p-4 spider-card">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div class="text-center mb-0 flex-grow-1">
                        <p class="mb-2">Intentos restantes: <span id="intentosRestantes" class="fw-bold">6</span></p>
                    </div>
                    <form asp-action="PedirPista" method="post">
                        <button type="submit" class="btn btn-outline-info btn-sm spider-btn">
                                    @if(pistasUsadas < 3)
                                    {
                                        <span>💡 Pedir Pista (@(3 - pistasUsadas) restantes)</span>
                                    }
                                    else
                                    {
                                        <span>💡 No quedan pistas</span>
                                    }
                            </button>
                    </form>
                </div>

                @if (!string.IsNullOrEmpty(errorPista))
                {
                    <div class="alert alert-warning mb-3" role="alert">@ViewBag.ErrorPista</div>
                }

                @if (!string.IsNullOrEmpty(pista))
                {
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>Pista @numeroPista:</strong> @pista
                    </div>
                }

                <div id="mensaje" class="alert d-none mb-3" role="alert"></div>

                <div class="cuadricula mb-4">
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                    <div class="fila">
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                        <div class="celda"></div>
                    </div>
                </div>

                <div class="text-center mb-4">
                    <p class="mb-2">Palabra actual: <span id="palabraActual" class="fw-bold">_ _ _ _ _</span></p>
                    <button id="borrar" class="btn btn-sm btn-secondary me-2 spider-btn">← Borrar</button>
                    <button id="confirmar" class="btn btn-sm btn-success spider-btn">Confirmar</button>
                </div>

                <div class="teclado">
                    <div class="fila-teclado">
                        <button class="tecla" data-letra="Q">Q</button>
                        <button class="tecla" data-letra="W">W</button>
                        <button class="tecla" data-letra="E">E</button>
                        <button class="tecla" data-letra="R">R</button>
                        <button class="tecla" data-letra="T">T</button>
                        <button class="tecla" data-letra="Y">Y</button>
                        <button class="tecla" data-letra="U">U</button>
                        <button class="tecla" data-letra="I">I</button>
                        <button class="tecla" data-letra="O">O</button>
                        <button class="tecla" data-letra="P">P</button>
                    </div>
                    <div class="fila-teclado">
                        <button class="tecla" data-letra="A">A</button>
                        <button class="tecla" data-letra="S">S</button>
                        <button class="tecla" data-letra="D">D</button>
                        <button class="tecla" data-letra="F">F</button>
                        <button class="tecla" data-letra="G">G</button>
                        <button class="tecla" data-letra="H">H</button>
                        <button class="tecla" data-letra="J">J</button>
                        <button class="tecla" data-letra="K">K</button>
                        <button class="tecla" data-letra="L">L</button>
                    </div>
                    <div class="fila-teclado">
                        <button class="tecla" data-letra="Z">Z</button>
                        <button class="tecla" data-letra="X">X</button>
                        <button class="tecla" data-letra="C">C</button>
                        <button class="tecla" data-letra="V">V</button>
                        <button class="tecla" data-letra="B">B</button>
                        <button class="tecla" data-letra="N">N</button>
                        <button class="tecla" data-letra="M">M</button>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="button" id="reiniciar" class="btn btn-warning spider-btn">Reiniciar</button>
                </div>

                <div id="codigoDiv" class="alert alert-success d-none mt-4">
                    <h5>¡Felicidades!</h5>
                    <p>Has completado el acertijo correctamente.</p>
                    <form action="@Url.Action("VerificarMinijuego", "Home")" method="post">
                        <input type="hidden" name="codigo" id="codigoInput" value="">
                        <button type="submit" class="btn btn-primary mt-3 spider-btn">Siguiente Minijuego</button>
                    </form>
                </div>

                <div id="derrrotaDiv" class="alert alert-danger d-none mt-4">
                    <h5>¡Perdiste!</h5>
                    <p>No pudiste adivinar la palabra en 6 intentos.</p>
                    <p class="mb-0">La palabra era: <span id="palabraSecreta" class="fw-bold"></span></p>
                    <button id="reiniciar" class="btn btn-warning mt-3 spider-btn">Reintentar</button>
                </div>

                <div id="datosMinijuego2" data-palabra="@palabraSecreta" data-codigo="@ViewBag.CodigoMinijuego" class="d-none"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/minijuegos.js"></script>
