@{
    ViewData["Title"] = "Inicio del Juego";
}

<section class="spider-hero mt-3">
    <div class="row align-items-center g-4 position-relative">
        <div class="col-lg-7">
            <span class="spider-eyebrow">🕷 Spider Escape</span>
            <h1 class="spider-title">Atrapa la salida antes de que el <span class="accent">simbionte</span> te alcance</h1>
            <p class="spider-subtitle">
                Resuelve las salas, descubre pistas y avanza como un verdadero héroe del multiverso.
                Cada desafío tiene el estilo de Spider-Man y una misión clara: escapar.
            </p>
            <div class="spider-cta-row">
                <a href="@Url.Action("Tutorial", "Home")" class="btn btn-primary btn-lg spider-btn">Comenzar misión</a>
                <a href="@Url.Action("Login", "Home")" class="btn btn-outline-info btn-lg spider-btn">Entrar de nuevo</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="spider-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="spider-badge">Nivel de amenaza</span>
                        <h2 class="mt-3 mb-0">Invasión arácnida</h2>
                    </div>
                    <div class="display-6">🕸️</div>
                </div>
                <div class="spider-landing-grid">
                    <div class="spider-feature">
                        <div class="icon">🧠</div>
                        <h3 class="h5">Piensa rápido</h3>
                        <p class="mb-0">Cada sala te obliga a resolver un reto distinto para abrir la siguiente puerta.</p>
                    </div>
                    <div class="spider-feature">
                        <div class="icon">💡</div>
                        <h3 class="h5">Usa las pistas</h3>
                        <p class="mb-0">Tienes un límite de ayudas por sala, así que úsalas con estrategia.</p>
                    </div>
                    <div class="spider-feature">
                        <div class="icon">🏃</div>
                        <h3 class="h5">Escapa</h3>
                        <p class="mb-0">Completa la secuencia, adivina la palabra y encuentra al enemigo final.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
