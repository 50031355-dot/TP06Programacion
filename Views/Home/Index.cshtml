@{
    ViewData["Title"] = "Home Page";
}


//boton de inicio de partida que lleve ala vista de Minijuego1 si estálogueado, sino que lleve a la vista de login
@if (User.Identity.IsAuthenticated)
{
    <a href="@Url.Action("Tutorial", "Home")" class="btn btn-primary">Empezar Juego</a>
}
else
{
    <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Iniciar Sesion</a>
}
