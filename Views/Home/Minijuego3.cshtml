@{
    ViewData["Title"] = "Minijuego 3";
}

<div class="container mt-4 venom-theme">
    <div class="text-center mb-4">
        <span class="spider-badge">🕷 Sala 3</span>
        <h1 class="mt-3 mb-2">El simbionte oculto</h1>
        <p class="text-white-50 venom-instrucciones mb-0">Venom se esconde entre las sombras. Encuentra la zona correcta de la imagen para completar la misión.</p>
    </div>
    <div class="venom-scene">
        <img src="~/img/foto venom.jpg" alt="Venom" class="venom-image" />
        <a asp-action="Victoria" asp-controller="Home" class="venom-button" aria-label="Encontrar a Venom">VENOM</a>
    </div>
</div>
