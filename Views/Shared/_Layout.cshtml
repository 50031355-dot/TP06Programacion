<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spider Escape</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tp06.styles.css" asp-append-version="true" />
</head>
<body class="spider-body">
    <header class="spider-header">
        <nav class="navbar navbar-expand-lg spider-navbar">
            <div class="container-xl">
                <a class="navbar-brand spider-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="spider-brand-mark">🕷</span>
                    <span>Spider Escape</span>
                </a>
                <button class="navbar-toggler spider-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-end">
                    <ul class="navbar-nav spider-nav">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="spider-main container-xl py-4">
        @RenderBody()
    </main>

    <footer class="spider-footer">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - Spider Escape</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
